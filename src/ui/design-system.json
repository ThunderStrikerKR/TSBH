  "operatingRules": {
    "roleClassification": "Information hierarchy and action importance are independent. Do not resize a primary action because it is inside a subsection.",
    "stateColors": "Neutral is default. Amber = needs action, green = success/wholesale when explicitly labeled, red = error/destructive, blue = selection/linked source; no decorative status colors.",
    "layout": "Align sibling inputs to the same label and value columns; button width adapts to label but heights/padding follow the role. Preserve money's right edge and VAT beside the amount.",
    "pendingKakaoToolbar": {
      "status": "approved-awaiting-ui-change",
      "location": "inside the KakaoTalk pane at the top, above the native Windows window docking area",
      "buttons": [
        {
          "id": "kakao-view-together",
          "label": "함께 보기",
          "role": "nav-subsection",
          "operation": "set OVERLAP"
        },
        {
          "id": "kakao-view-split",
          "label": "나누어 보기",
          "role": "nav-subsection",
          "operation": "set STACK"
        },
        {
          "id": "kakao-disconnect",
          "label": "카카오톡 연결 해제",
          "role": "action-quiet",
          "operation": "stop dock, restore native windows"
        }
      ],
      "interaction": "Three independent buttons. Never use a cycling/switch-to-next mode button. Active view indicated with aria-pressed.",
      "visibility": "Only show docked-mode controls while the native KakaoTalk session is connected.",
      "constraint": "The toolbar must remain within the Kakao pane and outside the native overlay region; do not cover KakaoTalk's chat input or list scrollbar."
    },
    "pendingBrand": {
      "status": "approved-awaiting-ui-change",
      "rule": "Brand symbol and BANDO HUB logotype should have comparable visual height; test-workspace label is subordinate; remove unidentified trailing stripe without deleting any functional separator."
    }
  }
